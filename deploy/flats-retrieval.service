[Unit]
Description=Flats Retrieval Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/appts-retrieval
EnvironmentFile=/opt/appts-retrieval/.env
ExecStart=/opt/appts-retrieval/venv/bin/python -m appts_retrieval
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
