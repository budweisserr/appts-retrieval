[Unit]
Description=Flats Retrieval Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/flats-retrieval
EnvironmentFile=/opt/flats-retrieval/.env
ExecStart=/opt/flats-retrieval/venv/bin/python -m flats_retrieval
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
